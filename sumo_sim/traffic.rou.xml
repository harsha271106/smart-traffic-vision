<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Heterogeneous Vehicle Classes with Sublane Parameters -->
    <vType id="motorcycle" length="1.9" width="0.7" maxSpeed="15.0" accel="2.8" decel="4.5" sigma="0.5"
           minGap="1.0" minGapLat="0.2" latAlignment="arbitrary" lcPushy="1.0" lcAssertive="1.5" vClass="motorcycle" guiShape="motorcycle" color="yellow"/>

    <vType id="auto_rickshaw" length="2.8" width="1.4" maxSpeed="12.0" accel="2.0" decel="3.8" sigma="0.5"
           minGap="1.5" minGapLat="0.3" latAlignment="compact" lcPushy="0.8" lcAssertive="1.2" guiShape="threeWheeler" color="0,0.8,0.2"/>

    <vType id="passenger_car" length="4.3" width="1.8" maxSpeed="16.0" accel="2.5" decel="4.0" sigma="0.5"
           minGap="2.0" minGapLat="0.4" latAlignment="compact" lcPushy="0.5" lcAssertive="1.0" vClass="passenger" guiShape="passenger" color="white"/>

    <vType id="bus" length="10.0" width="2.5" maxSpeed="10.0" accel="1.2" decel="3.0" sigma="0.3"
           minGap="2.5" minGapLat="0.6" latAlignment="center" lcPushy="0.2" lcAssertive="0.5" vClass="bus" guiShape="bus" color="orange"/>

    <vType id="ambulance" length="5.5" width="2.0" maxSpeed="20.0" accel="3.5" decel="4.5" sigma="0.2"
           minGap="1.5" minGapLat="0.3" latAlignment="compact" lcPushy="1.0" lcAssertive="1.5" vClass="emergency" guiShape="emergency" color="red"/>

    <!-- Corridor Turning and Straight Routes -->
    <!-- North Inflow -->
    <route id="r_N_straight" edges="N2C C2S"/>
    <route id="r_N_left"     edges="N2C C2E"/>
    <route id="r_N_right"    edges="N2C C2W"/>

    <!-- South Inflow -->
    <route id="r_S_straight" edges="S2C C2N"/>
    <route id="r_S_left"     edges="S2C C2W"/>
    <route id="r_S_right"    edges="S2C C2E"/>

    <!-- East Inflow -->
    <route id="r_E_straight" edges="E2C C2W"/>
    <route id="r_E_left"     edges="E2C C2N"/>
    <route id="r_E_right"    edges="E2C C2S"/>

    <!-- West Inflow -->
    <route id="r_W_straight" edges="W2C C2E"/>
    <route id="r_W_left"     edges="W2C C2S"/>
    <route id="r_W_right"    edges="W2C C2N"/>

    <!-- Vehicle Flows -->
    <flow id="f_N_str" route="r_N_straight" type="motorcycle" begin="0" end="3600" probability="0.10"/>
    <flow id="f_N_left" route="r_N_left" type="auto_rickshaw" begin="0" end="3600" probability="0.05"/>
    <flow id="f_N_right" route="r_N_right" type="passenger_car" begin="0" end="3600" probability="0.04"/>

    <flow id="f_E_str" route="r_E_straight" type="passenger_car" begin="0" end="3600" probability="0.08"/>
    <flow id="f_E_left" route="r_E_left" type="motorcycle" begin="0" end="3600" probability="0.08"/>
    <flow id="f_E_right" route="r_E_right" type="bus" begin="0" end="3600" probability="0.02"/>

    <flow id="f_S_str" route="r_S_straight" type="motorcycle" begin="0" end="3600" probability="0.10"/>
    <flow id="f_S_left" route="r_S_left" type="passenger_car" begin="0" end="3600" probability="0.05"/>
    <flow id="f_S_right" route="r_S_right" type="auto_rickshaw" begin="0" end="3600" probability="0.04"/>

    <flow id="f_W_str" route="r_W_straight" type="passenger_car" begin="0" end="3600" probability="0.08"/>
    <flow id="f_W_left" route="r_W_left" type="motorcycle" begin="0" end="3600" probability="0.07"/>
    <flow id="f_W_right" route="r_W_right" type="bus" begin="0" end="3600" probability="0.02"/>
</routes>